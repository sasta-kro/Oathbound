[node name="Knight" type="CharacterBody2D" parent="Actors" unique_id=530481467 instance=ExtResource("5_tnaed")]
position = Vector2(168, 96)
script = ExtResource("6_pahgs")
display_name = "KNIGHT"
body_color = Color(0.247059, 0.72549, 0.34902, 1)
sprite_frames = ExtResource("7_aichj")
dialogue_line = "Knight: Rest by the well, you look worn. The road through the north gate leads past the old ruins to the altar. Keep to it, and mind your manners when you reach the knight at the end of it."
heals_party = true
chatter = PackedStringArray()
barks = PackedStringArray()

[node name="Elder" type="CharacterBody2D" parent="Actors" unique_id=1448416974 instance=ExtResource("5_tnaed")]
position = Vector2(-24, 96)
script = ExtResource("6_pahgs")
display_name = "ELDER"
body_color = Color(0.75, 0.62, 0.86, 1)
sprite_frames = ExtResource("8_7oj63")
facing = &"right"
dialogue_line = "Elder: The board has work for anyone willing to leave the walls. Wild Oathbound roam the meadow, and the seal is thinning again up by the ruins."
quest_ids = Array[StringName]([&"quest_main_01_beyond_the_walls"])
chatter = PackedStringArray()
barks = PackedStringArray()

[node name="Merchant" type="CharacterBody2D" parent="Actors" unique_id=1278396786 instance=ExtResource("5_tnaed")]
position = Vector2(-504, -48)
script = ExtResource("6_pahgs")
display_name = "MERCHANT"
body_color = Color(0.9, 0.6, 0.3, 1)
sprite_frames = ExtResource("9_cpsmu")
dialogue_line = "Merchant: Fresh bread, dried fish, and a crate I still have not opened. The caravans come slower every year the bells start up."
quest_ids = Array[StringName]([&"quest_side_the_crossing"])
chatter = PackedStringArray()
barks = PackedStringArray()

[node name="Child" type="CharacterBody2D" parent="Actors" unique_id=1845064441 instance=ExtResource("5_tnaed")]
position = Vector2(-216, 432)
script = ExtResource("6_pahgs")
display_name = "CHILD"
body_color = Color(0.95, 0.85, 0.4, 1)
sprite_frames = ExtResource("10_qd58a")
facing = &"up"
dialogue_line = "Child: I saw a Loambuck from the wall! It had leaves on its back. Can I come with you? No? Fine."
quest_ids = Array[StringName]([&"quest_side_leaf_hat"])
chatter = PackedStringArray()
barks = PackedStringArray()

[node name="Innkeeper" type="CharacterBody2D" parent="Actors" unique_id=1620734297 instance=ExtResource("5_tnaed")]
position = Vector2(456, -144)
script = ExtResource("6_pahgs")
display_name = "INNKEEPER"
sprite_frames = ExtResource("11_ubjrp")
dialogue_line = "Innkeeper: Welcome to the Hearthside. Beds are warm and the stew is hot. Stay the night? Oathkeepers sleep free. The Order has always paid for its own."
runs_inn = true
chatter = PackedStringArray("Innkeeper: Back again? Your Oathbound look like they could use a proper bed.", "Innkeeper: The Fisher swears he caught tonight\'s stew. He didn\'t. Rest a while?")
barks = PackedStringArray("Stew\'s on!", "Rooms free tonight!", "Wipe your boots, please.")

[node name="Scribe" type="CharacterBody2D" parent="Actors" unique_id=378808644 instance=ExtResource("5_tnaed")]
position = Vector2(-648, -48)
script = ExtResource("6_pahgs")
display_name = "SCRIBE"
sprite_frames = ExtResource("12_msphj")
dialogue_line = "Scribe: Binding Scrolls, inked by my own hand. Oath-script holds better than any rope. It is the same hand that copies out the rite, for whatever that is worth to you."
quest_ids = Array[StringName]([&"quest_side_ink_and_oath"])
shop_stock = Array[StringName]([&"item_binding_scroll"])
shop_title = "Scribe's Stall"
chatter = PackedStringArray("Scribe: A worn-down creature listens closer. Weaken it before you offer the scroll.", "Scribe: Failed binding? The scroll crumbles, but the lesson stays. Buy another.")
barks = PackedStringArray("Scrolls! Fresh-inked scrolls!", "Bind your next friend!")

[node name="Apothecary" type="CharacterBody2D" parent="Actors" unique_id=1670163261 instance=ExtResource("5_tnaed")]
position = Vector2(-312, -48)
script = ExtResource("6_pahgs")
display_name = "APOTHECARY"
sprite_frames = ExtResource("13_114rs")
dialogue_line = "Apothecary: Salves for scrapes, tonics for worse, and a draught for when the worst has already happened. I have stocked every champion since I was young. Most of them came back."
quest_ids = Array[StringName]([&"quest_side_a_stocked_satchel"])
shop_stock = Array[StringName]([&"item_herb_salve", &"item_hearty_tonic", &"item_ember_draught", &"item_clearwater_vial"])
shop_title = "Apothecary"
chatter = PackedStringArray("Apothecary: Clearwater from the well, blessed twice. Burns and poisons don\'t stand a chance.", "Apothecary: Keep a salve in your satchel. The meadow bites harder than it looks.")
barks = PackedStringArray("Salves and tonics!", "Mind your wounds, traveller.")

[node name="Guard" type="CharacterBody2D" parent="Actors" unique_id=1463198793 instance=ExtResource("5_tnaed")]
position = Vector2(-72, -384)
script = ExtResource("6_pahgs")
display_name = "GUARD"
sprite_frames = ExtResource("14_ejftv")
dialogue_line = "Guard: The gate stays open while the sun is up. After dark, knock twice and say your oath. We have kept that rule since before the altar was raised."
chatter = PackedStringArray("Guard: Wild ones don\'t come past the wall. Mostly. Nothing has ever come past the altar.")
barks = PackedStringArray("Quiet day.", "Mind the ruins out there.")

[node name="OldMan" type="CharacterBody2D" parent="Actors" unique_id=1782004419 instance=ExtResource("5_tnaed")]
position = Vector2(216, -48)
script = ExtResource("6_pahgs")
display_name = "OLD MAN"
sprite_frames = ExtResource("15_5cvyu")
facing = &"left"
dialogue_line = "Old Man: The dead king has been put back under nine times since this town started keeping count, and the count was already old when we started it."
quest_ids = Array[StringName]([&"quest_side_a_proper_rest"])
chatter = PackedStringArray("Old Man: Sit a while. Well water tastes better when you\'re not rushing, and that altar has waited longer than you have.")
barks = PackedStringArray("Hmph. Pigeons.", "Back in my day...")

[node name="Fisher" type="CharacterBody2D" parent="Actors" unique_id=265085660 instance=ExtResource("5_tnaed")]
position = Vector2(600, 0)
script = ExtResource("6_pahgs")
display_name = "FISHER"
sprite_frames = ExtResource("16_qlm4h")
facing = &"up"
dialogue_line = "Fisher: Nothing biting but leeches. Don't tell the Innkeeper, she thinks I catch the stew."
chatter = PackedStringArray()
barks = PackedStringArray("Come on, bite...", "Was that a ripple?")

[node name="Bard" type="CharacterBody2D" parent="Actors" unique_id=1298564995 instance=ExtResource("5_tnaed")]
position = Vector2(-312, 384)
script = ExtResource("6_pahgs")
display_name = "BARD"
sprite_frames = ExtResource("17_sn4k3")
facing = &"right"
dialogue_line = "Bard: I'm writing a ballad about the Oathbreaker. Hardest song in the Reach. Nobody can agree on whether it is meant to end sad."
chatter = PackedStringArray("Bard: Every oath has a verse. Yours hasn\'t been written yet, and his has been sung wrong for a hundred years.")
barks = PackedStringArray("♪ Oh, the meadow grass was green... ♪", "♪ ...and the scroll held true ♪")

[node name="Kid" type="CharacterBody2D" parent="Actors" unique_id=463300445 instance=ExtResource("5_tnaed")]
position = Vector2(-120, 384)
script = ExtResource("6_pahgs")
display_name = "KID"
sprite_frames = ExtResource("18_wqf6r")
dialogue_line = "Kid: I'm faster than an Emberling! Watch! ...Okay, not yet. Soon."
chatter = PackedStringArray()
barks = PackedStringArray("Can\'t catch me!", "Race you to the well!")
wander_radius_cells = 2.0

[node name="Villager" type="CharacterBody2D" parent="Actors" unique_id=2132140143 instance=ExtResource("5_tnaed")]
position = Vector2(120, 192)
script = ExtResource("6_pahgs")
display_name = "VILLAGER"
sprite_frames = ExtResource("19_r8iu2")
dialogue_line = "Villager: The market's busier since the caravan came. Even the Scribe is selling scrolls again."
chatter = PackedStringArray("Villager: If you\'re heading out, the Apothecary\'s salves are worth every coin.")
barks = PackedStringArray("Fresh bread smells lovely today.", "Has anyone seen my cat?")
wander_radius_cells = 3.0

[node name="Farmer" type="CharacterBody2D" parent="Actors" unique_id=158575293 instance=ExtResource("5_tnaed")]
position = Vector2(-456, 240)
script = ExtResource("6_pahgs")
display_name = "FARMER"
sprite_frames = ExtResource("20_sch8w")
dialogue_line = "Farmer: Loambucks keep nibbling the hay. Can't blame them, it's good hay."
quest_ids = Array[StringName]([&"quest_side_field_medicine"])
chatter = PackedStringArray()
barks = PackedStringArray("Hay won\'t stack itself.", "Rain\'s coming, I can feel it.")
wander_radius_cells = 2.0

