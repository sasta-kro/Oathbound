[node name="BlackKnight" parent="Actors" unique_id=538972721 instance=ExtResource("7_b42mx")]
position = Vector2(840, -408)
species = ExtResource("19_boss")
level = 14
ability_index = 0
boss_id = &"boss_area_01"
required_quest = &"quest_main_03_the_black_knight"
challenge_line = "The Oathbreaker: So. She has the water, the wood and the iron, and she sends me another one. Good.\n\nHear it the way every one of you hears it. They named me Oathbreaker. I did not break it.\n\nIt was broken for me, in the hour my king reached past what a king may touch, and it went through his knights before it ever reached his son.\n\nWhat I keep now, I chose. I keep this door, and I do not open it for anyone who cannot take it from me. Come and show me you can carry him."
sealed_line = "Not yet. The rite is not whole,"
victory_line = "The Oathbreaker: Good. That is the one I was waiting for.\n\nHe grounds his sword and steps out of the way of the altar. Set them down. Water, wood and iron.\n\nThe stone drinks the offerings and wakes, and a stair opens beneath the altar.\n\nGo down and put him back to sleep once more."
leash_radius = 0.0
chatter = PackedStringArray()
barks = PackedStringArray()

