[node name="Scout" parent="Actors" unique_id=171869106 instance=ExtResource("5_10dds")]
position = Vector2(120, 648)
display_name = "SCOUT"
body_color = Color(0.35, 0.6, 0.85, 1)
sprite_frames = ExtResource("npc_scout_frames")
facing = &"left"
dialogue_line = "Scout: Follow the road and you will not get lost. It bends past the pond and climbs to the ruins. The altar is at the very end, and the knight is in front of it, same as he always is."
quest_ids = Array[StringName]([&"quest_main_01a_a_second_oath", &"quest_main_01b_room_for_more", &"quest_main_01c_field_mending", &"quest_main_01d_who_walks_in_front", &"quest_main_01e_strike_first", &"quest_main_01f_caught_in_the_open", &"quest_main_01g_no_battle_at_all", &"quest_main_01h_a_bed_at_the_hearthside", &"quest_main_02_the_ruined_road", &"quest_main_02_to_the_ranger"])

[node name="Ranger" parent="Actors" unique_id=1167905662 instance=ExtResource("5_10dds")]
position = Vector2(600, 168)
display_name = "RANGER"
body_color = Color(0.3, 0.55, 0.35, 1)
sprite_frames = ExtResource("npc_scout_frames")
facing = &"right"
dialogue_line = "Ranger: The pond feeds half the meadow, and the altar's stillwater comes out of it. When something troubles this water, everything out here feels it."
quest_ids = Array[StringName]([&"quest_main_02a_scalded_shallows", &"quest_main_02a_to_the_woodcutter", &"quest_side_leech_shallows"])

[node name="Woodcutter" parent="Actors" unique_id=763757081 instance=ExtResource("5_10dds")]
position = Vector2(-696, 168)
display_name = "WOODCUTTER"
body_color = Color(0.6, 0.45, 0.3, 1)
sprite_frames = ExtResource("npc_merchant_frames")
facing = &"up"
dialogue_line = "Woodcutter: The deeper you go into these woods, the meaner the things that live there. Always worse when the seal thins, and it is thinning. Same goes for the road north."
quest_ids = Array[StringName]([&"quest_main_02b_wings_in_the_wood", &"quest_main_02b_to_the_warden"])

[node name="Hermit" parent="Actors" unique_id=650279819 instance=ExtResource("5_10dds")]
position = Vector2(-408, -312)
display_name = "HERMIT"
body_color = Color(0.55, 0.55, 0.5, 1)
sprite_frames = ExtResource("npc_elder_frames")
facing = &"right"
dialogue_line = "Hermit: The ruins? Hah. I went up there once, young and proud, and the knight sent me back down kindly. He is always kind about it."
quest_ids = Array[StringName]([&"quest_side_feathers_on_the_rise"])

[node name="Warden" parent="Actors" unique_id=1634673678 instance=ExtResource("5_10dds")]
position = Vector2(648, -120)
display_name = "WARDEN"
body_color = Color(0.25, 0.7, 0.35, 1)
sprite_frames = ExtResource("npc_knight_frames")
facing = &"up"
dialogue_line = "Warden: Rest a moment. I'll see your Oathbound mended. Whatever you do next, don't face the altar tired. Nobody has ever beaten him tired."
heals_party = true
quest_ids = Array[StringName]([&"quest_main_02c_the_hollow_watch", &"quest_main_03_the_black_knight", &"quest_main_04_the_stair_shut"])

