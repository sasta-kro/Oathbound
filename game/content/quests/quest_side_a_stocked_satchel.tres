[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2_objective")
kind = 4
target = &"bought_item_herb_salve"
count = 2
description = "Buy two Herb Salves from the Apothecary"

[resource]
script = ExtResource("1_quest")
id = &"quest_side_a_stocked_satchel"
title = "A Stocked Satchel"
kind = 1
giver = &"apothecary"
requires = &""
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_1")])
summary = "The Apothecary will not let a new Oathkeeper past the gate without something for their wounds."
reward_currency = 20
reward_xp = 10
reward_item = &"item_clearwater_vial"
reward_item_count = 1
offer_line = "Apothecary: You are going out there with nothing in your satchel? Buy two salves from me. Humour an old worrier."
accept_option = "Two salves it is."
refuse_option = "I'll manage."
accepted_line = "Apothecary: Good. Twenty coins each, and worth every one."
refused_line = "Apothecary: That is what they all say, right before they limp home."
reoffer_line = "Apothecary: Ready to stock that satchel now?"
progress_line = "Apothecary: Two salves. I'll count them."
abandoned_line = "Apothecary: Suit yourself. The shelves will be here."
complete_line = "Apothecary: There. Now you look like someone who plans to come back. Take this vial as well, on the house."
done_line = "Apothecary: Salve on the wound, not on the bread. You would be surprised."
