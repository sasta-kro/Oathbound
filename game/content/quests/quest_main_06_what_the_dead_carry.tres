count = 2
description = "Clear two Mirelashes off the flooded hall"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_06_what_the_dead_carry"
title = "What the Dead Carry"
kind = 0
summary = "The Gravewright digs for the champions these halls take and lifts the seal-iron off them so the sigil can go home even when they cannot.\n\nTwo lie where he cannot reach, with Mirelashes sitting over both."
giver = &"gravewright"
requires = &"quest_main_05_to_the_gravewright"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_0"), SubResource("Objective_1"), SubResource("Objective_2")])
reward_currency = 110
reward_binding_scrolls = 3
reward_xp = 1000
recommended_level = 21
offer_line = "The Gravewright: Mind where you tread. They are all champions, every one of these. I dig for the ones the halls take, and I lift the seal-iron off them, because the iron can go home even when they can't.\n\nTwo are out where I cannot reach, one under the southwest flood and one at the old camp, and there are Mirelashes sitting over both.\n\nBring their sigils in. They should not be left lying in his halls."
accept_option = "I'll bring them in."
refuse_option = "Not now."
accepted_line = "The Gravewright: Water and earth put a Mirelash down. Don't let one get its mouth on you; they hold."
caution_line = "The Gravewright: Those Mirelashes are heavier than anything you met upstairs. Nearer level %d, if you want my advice, and you should, because I bury the ones who didn't take it."
refused_line = "The Gravewright: They have lain there a long time. They will lie a while more."
reoffer_line = "The Gravewright: Those two are still out there. Changed your mind?"
progress_line = "The Gravewright: Southwest flood and the old camp. Any luck?"
continue_option = "Still at it."
abandon_option = "I can't face it."
abandoned_line = "The Gravewright: I'll not press you. It is not pleasant work and it was never yours to do."
complete_line = "The Gravewright: Both of them. Good. Half of this goes in the ground with their names on it and half goes to the Sealwright, and the Sealwright cuts it into scrolls, and the scrolls go to you.\n\nNo coin, don't offer. That is how this place works: the last one leaves the next one better off than they were.\n\nForty-one times we have done it, and every champion who walks up that road carries something one of us paid for.\n\nTake them. The Bellkeeper wants you next. She is in the bell-hall and she is shouting about it."
done_line = "The Gravewright: Bell-hall, north end. She has not stopped shouting."
