[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_rout"]
script = ExtResource("2_objective")
kind = 4
target = &"routed_in_the_field"
count = 1
description = "Cut a weak creature down with F without a battle opening at all"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_01g_no_battle_at_all"
title = "No Battle At All"
kind = 0
summary = "A blow big enough to finish a creature outright never opens a battle screen: it falls in the grass where it stands, and it still pays what it would have paid.\n\nThe Scout would rather the player learned that now than found it out by accident halfway up the road."
giver = &"scout"
requires = &"quest_main_01f_caught_in_the_open"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_rout")])
reward_currency = 20
reward_xp = 10
taught_key = &"attack"
offer_line = "Scout: One more thing about F. If your hit is bigger than a creature's remaining health, there's no fight at all. It drops, and you still get the rewards."
accept_option = "Show me that."
refuse_option = "Another time."
accepted_line = "Scout: I'll find you something that's nearly beaten."
refused_line = "Scout: Then you'll fight everything on the road. Your choice."
reoffer_line = "Scout: Want to see a fight end before it starts?"
progress_line = "Scout: It's nearly beaten. Press F."
continue_option = "I'll put it down."
abandon_option = "Not now."
abandoned_line = "Scout: As you like."
complete_line = "Scout: No fight, and you still got paid. If something is nearly beaten, just hit it. That's all the fighting I can teach. Two errands, then the road."
done_line = "Scout: Nearly beaten? Don't fight it. Hit it."
