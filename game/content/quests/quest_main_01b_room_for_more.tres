[gd_resource type="Resource" script_class="QuestData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_keep"]
script = ExtResource("2_objective")
kind = 4
target = &"kept_an_oathbound"
count = 1
description = "Open your party page (Tab) and send one Oathbound to keeping"

[sub_resource type="Resource" id="Objective_call_back"]
script = ExtResource("2_objective")
kind = 4
target = &"called_back_an_oathbound"
count = 1
description = "Call it back out of keeping"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_01b_room_for_more"
title = "Room for More"
kind = 0
summary = "Three Oathbound walk with you and no more, but nothing you bind is ever turned away: whatever will not fit walks down to the Hearthside and waits in the paddock until you send for it.\n\nSending one away and calling it back is done from the party page."
giver = &"scout"
requires = &"quest_main_01a_a_second_oath"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_keep"), SubResource("Objective_call_back")])
reward_currency = 20
reward_binding_scrolls = 1
reward_xp = 10
taught_key = &"party"
offer_line = "Scout: Only three Oathbound can walk with you. Extras wait in the paddock until you call them back. Let me show you."
accept_option = "Show me the paddock."
refuse_option = "Later."
accepted_line = "Scout: Press Tab to open your party page."
refused_line = "Scout: Later, then."
reoffer_line = "Scout: Ready to try the paddock?"
progress_line = "Scout: Press Tab. Send one to keeping, then call it back."
continue_option = "I'll try it now."
abandon_option = "Not now."
abandoned_line = "Scout: When you're ready."
complete_line = "Scout: That's it. Bind anything you find; there's always room for it."
done_line = "Scout: Three walk, the rest are kept. Bind everything."
