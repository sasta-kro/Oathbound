[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_rest"]
script = ExtResource("2_objective")
kind = 4
target = &"rested_at_inn"
count = 1
description = "Sleep a night at the Hearthside Inn, down in the town"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_01h_a_bed_at_the_hearthside"
title = "A Bed at the Hearthside"
kind = 0
summary = "The Scout will not send anyone up the ruined road on a tired party.\n\nA night at the Hearthside Inn, down through the gate, mends every Oathbound to full and costs nothing, and the bed you slept in is where you wake if the road puts you down."
giver = &"scout"
turn_in = &"innkeeper"
requires = &"quest_main_01g_no_battle_at_all"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_rest")])
reward_currency = 20
reward_xp = 10
reward_item = &"item_healing_herb"
reward_item_count = 1
offer_line = "Scout: Your Oathbound are worn out. Sleep at the Hearthside Inn in town. It's free, it heals everyone, and it's where you'll wake if you're beaten."
accept_option = "A bed sounds good."
refuse_option = "We're fine."
accepted_line = "Scout: Back down the road into town. The Innkeeper is by the pond, on the east side."
refused_line = "Scout: You're not fine. Go when you're ready."
reoffer_line = "Scout: Changed your mind about that bed?"
progress_line = "Scout: The Hearthside. Down through the gate, east side of the town, by the pond."
continue_option = "I'm going."
abandon_option = "I'd rather push on."
abandoned_line = "Scout: The offer stands."
complete_line = "Innkeeper: There. Fed, watered and mended, and not a coin between us.\n\nAny night you want it, the bed is here, and if something out there puts your Oathbound down, this is where you will wake up, so remember the way.\n\nTake this salve as well. And stay where you are a moment, I am not finished with you."
done_line = "Innkeeper: Bed's always made. Sleep costs you nothing but the night."
