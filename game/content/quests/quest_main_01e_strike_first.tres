[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_strike"]
script = ExtResource("2_objective")
kind = 4
target = &"first_strike_landed"
count = 1
description = "Walk up to the creature and hit it with F before it moves"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_01e_strike_first"
title = "Strike First"
kind = 0
summary = "The Scout has watched you stand and wait for things to come at you.\n\nOut on the road the first blow is usually the one that decides the fight, and it is thrown with F, in the open, before a battle ever opens."
giver = &"scout"
requires = &"quest_main_01d_who_walks_in_front"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_strike")])
reward_currency = 20
reward_xp = 15
taught_key = &"attack"
offer_line = "Scout: Out here, hit first. Press F and your leader attacks whatever you're facing. Land it before a fight and you get the first turn."
accept_option = "Show me."
refuse_option = "Later."
accepted_line = "Scout: There's one in the grass. Face it and press F."
refused_line = "Scout: Suit yourself."
reoffer_line = "Scout: Ready to learn to hit first?"
progress_line = "Scout: Face it and press F."
continue_option = "I'll go and hit it."
abandon_option = "Not now."
abandoned_line = "Scout: It'll be there when you're ready."
complete_line = "Scout: See? It started the fight already hurt, and you moved first. Do that every time."
done_line = "Scout: Press F first. Never wait to be hit."
