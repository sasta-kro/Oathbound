[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_strike"]
script = ExtResource("2_objective")
kind = 4
target = &"first_strike_landed"
count = 1
description = "Walk up to the creature and hit it with F before it moves"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_01e_strike_first"
title = "Strike First"
kind = 0
summary = "The Scout has watched you stand and wait for things to come at you.\n\nOut on the road the first blow is usually the one that decides the fight, and it is thrown with F, in the open, before a battle ever opens."
giver = &"scout"
requires = &"quest_main_01d_who_walks_in_front"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_strike")])
reward_currency = 20
reward_xp = 15
offer_line = "Scout: Third thing, and it is the one that keeps you alive.\n\nYou have been standing about waiting for these things to come to you. Don't. Out here you hit first.\n\nPress F and whichever Oathbound walks at your shoulder throws its best blow the way you're facing.\n\nLand it before the fight opens and you start that fight a turn up. Let me find you something to practise on."
accept_option = "Show me."
refuse_option = "Later."
accepted_line = "Scout: There's one in the grass down the slope. Walk up on it and hit F. Close enough to touch, mind; your partner has arms, not a bow."
refused_line = "Scout: Suit yourself. Stand and wait, then, and see how that goes for you."
reoffer_line = "Scout: Ready to learn to swing first?"
progress_line = "Scout: Get close and press F. That's all there is to it."
continue_option = "I'll go and hit it."
abandon_option = "Not now."
abandoned_line = "Scout: Fine. It'll be in the grass when you change your mind."
complete_line = "Scout: That's it. See how it came into the fight already bleeding? Do that every time. Now sit back down, because the next lesson is the same one from the wrong end."
done_line = "Scout: F, and close. Never wait to be swung at."
