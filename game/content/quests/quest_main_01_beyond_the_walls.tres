[sub_resource type="Resource" id="Objective_reach_meadow"]
script = ExtResource("2_objective")
kind = 3
target = &"res://areas/area_one.tscn"
description = "Pass through the north gate into the meadow"

[sub_resource type="Resource" id="Objective_find_scout"]
script = ExtResource("2_objective")
kind = 2
target = &"scout"
description = "Find the Scout at the camp by the road"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_01_beyond_the_walls"
title = "Beyond the Walls"
kind = 0
summary = "The bells beneath the altar rang again and the seal is thinning.\n\nThe Elder has sent the Order's newest Oathkeeper to the scout camped past the north gate, who keeps the road and the rite that puts the dead king back to sleep."
giver = &"elder"
turn_in = &"scout"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_reach_meadow"), SubResource("Objective_find_scout")])
reward_currency = 40
reward_binding_scrolls = 1
offer_line = "Elder: The bells rang beneath the altar last night, and the watch falls to you. Our scout is camped past the north gate.\n\nHe keeps that road, and he keeps the rite with it. Find him, hear what he has seen, and do as he tells you. Will you go?"
accept_option = "I'll find him."
refuse_option = "Not today."
accepted_line = "Elder: Follow the road north and keep to it. Come back and tell me what he says."
refused_line = "Elder: Then rest. The seal will hold a few days yet, and so will I."
reoffer_line = "Elder: The scout is still out there past the gate, and the bells have not stopped. Have you changed your mind?"
progress_line = "Elder: Have you found the scout yet?"
continue_option = "Still looking."
abandon_option = "I can't go out there."
abandoned_line = "Elder: I understand. It is no small thing to ask of anyone, whatever the tradition says. Come back if your heart changes."
complete_line = "Scout: The Elder sent you up?\n\nThen it is your turn at the altar. Good.\n\nI have walked that road with more champions than I care to count, and I tell every one of them the same thing: the rite comes first, the knight comes second, and the king comes last. We start at the beginning. Take these."
done_line = "Elder: You found the scout. Good. Do as he says, and in the order he says it. The road has only ever killed the ones who skipped ahead."
