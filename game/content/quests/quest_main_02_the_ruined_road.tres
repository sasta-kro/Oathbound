[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_clear_emberlings"]
script = ExtResource("2_objective")
kind = 0
target = &"creature_fire_01"
count = 3
description = "Drive three Emberlings off the ruined road"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_02_the_ruined_road"
title = "The Ruined Road"
kind = 0
summary = "Three offerings go on the altar, and all three have to be carried up the ruined road by hand. Emberlings have taken to that road by the ruins and burn anything that walks it."
giver = &"scout"
requires = &"quest_main_01b_field_mending"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_clear_emberlings")])
reward_currency = 60
reward_binding_scrolls = 2
reward_xp = 40
recommended_level = 8
offer_line = "Scout: Now it starts in earnest. Three offerings go on that altar, and every one of them is carried up the road on foot. At present the road cannot be walked. Emberlings have taken to it by the ruins and they burn whatever passes. Drive three of them off and the way up is ours again."
accept_option = "Consider it done."
refuse_option = "Not right now."
accepted_line = "Scout: They gather up the road toward the ruins. Strike first if you can; they do not wait for you to be ready."
refused_line = "Scout: Then I will sit by my fire a little longer. The seal is not through yet."
reoffer_line = "Scout: The Emberlings are still on the road. Ready to try?"
progress_line = "Scout: How goes the road?"
continue_option = "Still at it."
abandon_option = "I can't manage it."
abandoned_line = "Scout: No shame in it. They are fierce little things."
complete_line = "Scout: The road is quiet. Now the rite itself. Three offerings, and every one has to come out of the living world, because that is the one thing the dead king has none of. Water first. The Ranger keeps watch on the far side of the pond, north-east of this camp. Walk up the meadow with the water on your right and you'll find her on the north shore. She draws the stillwater for the altar, and just now she cannot draw a drop of it. Help her."
done_line = "Scout: The Ranger is north-east of here, on the north shore of the pond. Keep the water on your right as you go up and you can't miss her."
caution_line = "Scout: One thing. Those Emberlings are older and meaner than the one the Elder put in your hands. Get your partner closer to level %d before you go looking for trouble; the meadow Loambucks are good practice."
