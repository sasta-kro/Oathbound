[sub_resource type="Resource" id="Objective_bind_loambuck"]
script = ExtResource("2_objective")
kind = 1
target = &"creature_loambuck"
count = 1
description = "Bind a Loambuck"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_01a_a_second_oath"
title = "A Second Oath"
kind = 0
summary = "The Scout will not let anyone carry the rite up the ruined road on a single partner. Loambucks graze the meadow west of his camp, and a Loambuck can mend its partners in the middle of a fight."
giver = &"scout"
requires = &"quest_main_01_beyond_the_walls"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_bind_loambuck")])
reward_currency = 30
reward_binding_scrolls = 1
reward_xp = 10
offer_line = "Scout: Don't go up that road with only one Oathbound. Loambucks can heal their partners in a fight. Let's get you one."
accept_option = "I'll bind a Loambuck."
refuse_option = "Not yet."
accepted_line = "Scout: Weaken it first, then use a Binding Scroll. A tired one is easier to bind."
refused_line = "Scout: Suit yourself. Talk to me when you're ready."
reoffer_line = "Scout: Ready to bind a Loambuck?"
progress_line = "Scout: Let's try that Loambuck again."
continue_option = "Still looking."
abandon_option = "I'd rather not."
abandoned_line = "Scout: Your choice."
complete_line = "Scout: Good. Keep that Loambuck close. It can heal your Emberling in a fight."
done_line = "Scout: A Loambuck at your back is worth three scrolls."
