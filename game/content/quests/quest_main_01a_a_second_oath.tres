[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_bind_loambuck"]
script = ExtResource("2_objective")
kind = 1
target = &"creature_earth_01"
count = 1
description = "Bind a Loambuck"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_01a_a_second_oath"
title = "A Second Oath"
kind = 0
summary = "The Scout will not let anyone carry the rite up the ruined road on a single partner. Loambucks graze the meadow west of his camp, and a Loambuck can mend its partners in the middle of a fight."
giver = &"scout"
requires = &"quest_main_01_beyond_the_walls"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_bind_loambuck")])
reward_currency = 30
reward_binding_scrolls = 1
reward_xp = 10
offer_line = "Scout: First thing, and do not argue it.\n\nNobody carries the rite up that road alone. An Emberling alone burns hot and burns out, and everything between here and the altar is older than it is.\n\nYou want someone at its back. Loambucks graze the meadow west of this camp. They are slow, but they mend. Bind one."
accept_option = "I'll bind a Loambuck."
refuse_option = "Not yet."
accepted_line = "Scout: Knock it about a little first. A tired Loambuck takes the scroll far more readily than a fresh one. Don't overdo it, mind."
refused_line = "Scout: Suit yourself. The meadow isn't going anywhere, and neither is the altar."
reoffer_line = "Scout: Still going it alone? Loambucks, west of here. Bind one."
progress_line = "Scout: Any luck in the meadow? West of the camp, in the tall grass."
continue_option = "Still looking."
abandon_option = "I'd rather not."
abandoned_line = "Scout: Your choice. Don't say I didn't warn you."
complete_line = "Scout: That's a fine one. Look at it, already sniffing your Emberling for scrapes. Keep it close.\n\nFire will not serve you up there; half of what the dead king left behind is fire already.\n\nThings that grow are the one thing he never had. I'll show you why."
done_line = "Scout: A Loambuck at your back is worth three scrolls in your pack."
