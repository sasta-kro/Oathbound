[resource]
script = ExtResource("1_quest")
id = &"quest_main_01c_field_mending"
title = "Field Mending"
kind = 0
summary = "The Scout wants to show how a mender fights before the altar road teaches it the hard way: a healer can patch up a partner on the bench, not only itself."
giver = &"scout"
requires = &"quest_main_01b_room_for_more"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_win_lesson")])
reward_currency = 40
reward_binding_scrolls = 1
reward_xp = 20
offer_line = "Scout: Next, how to heal in a fight. Stay by the fire a moment."
accept_option = "Show me."
refuse_option = "Later."
accepted_line = "Scout: A healer can mend a partner that's sitting out the fight, not just itself."
refused_line = "Scout: Later, then."
reoffer_line = "Scout: Ready for the healing lesson?"
progress_line = "Scout: Again? Swap, mend, swap back."
continue_option = "Let's go again."
abandon_option = "Not now."
abandoned_line = "Scout: Talk to me when you want to try again."
complete_line = "Scout: See? Swap, mend, swap back. That will keep you alive."
done_line = "Scout: Swap, mend, swap back."
