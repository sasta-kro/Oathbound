target = &"creature_earth_07"
count = 1
description = "Bring down the Kingsworn in the mouth of the stair"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_09_the_kingsworn"
title = "The Kingsworn"
kind = 0
summary = "One of the king's own knights stands in the stair down to the wood and has stood in it for four hundred years.\n\nHe was sworn to a man who went to the god of the dead, and the oath took him along whether he willed it or not."
giver = &"aldric"
requires = &"quest_main_08_to_aldric"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_0")])
reward_currency = 200
reward_binding_scrolls = 3
reward_xp = 1600
recommended_level = 27
offer_line = "Aldric: There it is. That black throat in the wall is the way down to his wood, and the thing standing in it is one of his own knights. Kingsworn.\n\nHe has stood in that gap four hundred years and he says the same four words to everyone who comes near it.\n\nNot while I hold this door.\n\nHe is not cruel and he is not mad. He was sworn to a man who went to the god of the dead, and the oath took him along whether he willed it or not, same as the one you beat at the altar. He does not want to be there, but this one He will kill you."
accept_option = "I can take him."
refuse_option = "Not yet."
accepted_line = "Aldric: He fights like a man holding a doorway, because he is. He will not chase you and he will not tire.\n\nWear him down and keep something back for the end; he saves the worst of it for when you think it is over."
caution_line = "Aldric: I will not talk you out of it. I will say this: he is stronger than the knight at the altar, and the knight at the altar was the kind one.\n\nLevel %d at the least. Train in the halls; he is not going anywhere."
refused_line = "Aldric: Then he keeps the door another day. He has kept it longer."
reoffer_line = "Aldric: The Kingsworn is still in the stair. Are you ready for him?"
progress_line = "Aldric: He is where he has always been. Take your time. I have."
continue_option = "I'm going back in."
abandon_option = "I can't beat him."
abandoned_line = "Aldric: I am the last man alive who is going to think less of you for it."
complete_line = "Aldric: Good job besting him.\n\nI carried the rite to that doorway thirty years ago and I stood in front of him and I knew, the way you know a thing in your chest, that I did not have it in me.\n\nSo I turned round and I came back to this fire, and the day I set the rite down was the day the stair stopped knowing my name.\n\nThat is my business and not yours. Go on down. The wood is his own ground and it is nothing like these halls.\n\nFind the champion who keeps the stair at the bottom; she has been there longer than I have been down here, and she will tell you the road."
done_line = "Aldric: Down the stair and look to your left. She sits against a dead tree and she will not get up. Let her tell it her way."
