[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_buy"]
script = ExtResource("2_objective")
kind = 4
target = &"bought_item_herb_salve"
count = 1
description = "Buy a Herb Salve at the Apothecary's counter in the town"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_01g_a_stocked_satchel"
title = "A Stocked Satchel"
kind = 0
summary = "Coins are for spending. The Apothecary keeps a counter across the town and sells what mends an Oathbound between fights, and the Innkeeper will not watch another one leave her door with an empty satchel."
giver = &"innkeeper"
turn_in = &"apothecary"
requires = &"quest_main_01f_a_bed_at_the_hearthside"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_buy")])
reward_currency = 25
reward_xp = 10
reward_item = &"item_clearwater_vial"
reward_item_count = 1
offer_line = "Innkeeper: Before you go back up to him. Your satchel is empty; I checked it while you slept, and no, I am not sorry. Take those coins across to the Apothecary and buy a Herb Salve off her, one at least. A salve is a mend you can use when nothing in your party knows how, and up on that road there is no fire and no bed, only what you carried out of my door."
accept_option = "I'll stock up."
refuse_option = "I'll keep my coins."
accepted_line = "Innkeeper: Her counter is over on the west side, by the stalls. Talk to her, look at what is on the shelf, and buy the salve. Twenty coins, and it has bought better people than you another hour."
refused_line = "Innkeeper: Keep your coins, then. They are no use to anybody in a dead Oathkeeper's purse."
reoffer_line = "Innkeeper: Ready to spend a little of that purse?"
progress_line = "Innkeeper: The Apothecary. West side of the town, by the stalls. One salve."
continue_option = "On my way."
abandon_option = "Not now."
abandoned_line = "Innkeeper: Your satchel, your funeral."
complete_line = "Apothecary: Good. Now it is in your satchel, use it; a salve in the bag has never healed anybody. Take this vial too, on the house, and tell that Scout of yours I said you were sensible. He has the road waiting for you, and you are as ready for it as I can make you."
done_line = "Apothecary: Salve on the wound, not on the bread. You would be surprised."
