[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2_objective")
kind = 4
target = &"used_item_healing_herb"
count = 1
description = "Use a Healing Herb on a hurt companion"

[resource]
script = ExtResource("1_quest")
id = &"quest_side_field_medicine"
title = "Field Medicine"
kind = 1
giver = &"farmer"
requires = &""
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_1")])
summary = "The Farmer wants to see a salve actually work before he buys any for his mule."
reward_currency = 30
reward_xp = 15
offer_line = "Farmer: My mule got nipped by a Loambuck. The Apothecary swears by her salves, but I have never seen one work. Patch up one of yours and show me?"
accept_option = "I'll show you."
refuse_option = "Ask the Apothecary."
accepted_line = "Farmer: Salves come from the Apothecary at the market. Use one on a companion that took a knock, from your satchel or mid-fight."
refused_line = "Farmer: She would just try to sell me three."
reoffer_line = "Farmer: Changed your mind about showing me that salve?"
progress_line = "Farmer: Used a salve yet? A companion has to be hurt for it to do anything."
abandoned_line = "Farmer: Fine, fine. The mule will live."
complete_line = "Farmer: Well I never. Closed right up. Here, for your trouble. I'll be buying a tin for the mule."
done_line = "Farmer: The mule is doing better. Still bites, though."
