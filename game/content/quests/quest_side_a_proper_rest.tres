[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2_objective")
kind = 4
target = &"rested_at_inn"
count = 1
description = "Spend a night at the Hearthside Inn"

[resource]
script = ExtResource("1_quest")
id = &"quest_side_a_proper_rest"
title = "A Proper Night's Sleep"
kind = 1
giver = &"oldman"
requires = &""
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_1")])
summary = "The Old Man thinks you look half dead and wants you to sleep at the inn before you do anything brave."
reward_currency = 15
reward_xp = 10
reward_item = &"item_herb_salve"
reward_item_count = 2
offer_line = "Old Man: You look half dead. Sleep at the Hearthside tonight, then come tell me whether the stew is still terrible."
accept_option = "I could use the sleep."
refuse_option = "I'm fine."
accepted_line = "Old Man: The Innkeeper is by the pond. Beds are free for the Order's own, and that is you now. The stew costs your dignity."
refused_line = "Old Man: Everybody is fine until they fall over."
reoffer_line = "Old Man: Have you slept yet? You still look like a ghost."
progress_line = "Old Man: Well? The inn is right by the pond."
abandoned_line = "Old Man: Suit yourself. Sleep is for the old anyway."
complete_line = "Old Man: Ha! Still terrible, is it? Good. Some things should never change. Take these salves, I never use them."
done_line = "Old Man: Rest when you can. The road does not care how tired you are."
