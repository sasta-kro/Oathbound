[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_find"]
script = ExtResource("2_objective")
kind = 2
target = &"ranger"
count = 1
description = "Find the Ranger on the north shore of the pond"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_02_to_the_ranger"
title = "Word with the Ranger"
kind = 0
summary = "The first of the three offerings is water, and the Ranger draws it.\n\nShe keeps watch on the north shore of the pond, north-east of the Scout's camp, and something in the shallows has stopped her drawing a drop."
giver = &"scout"
turn_in = &"ranger"
requires = &"quest_main_02_the_ruined_road"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_find")])
reward_currency = 10
reward_xp = 10
offer_line = "Scout: Go and see the Ranger. North-east, up the meadow, with the water on your right."
accept_option = "I'll find her."
refuse_option = "Give me a moment."
accepted_line = "Scout: You can't miss her."
refused_line = "Scout: She'll still be there."
reoffer_line = "Scout: Ready to go and see the Ranger?"
progress_line = "Scout: North-east, up the meadow. Keep the water on your right."
complete_line = "Ranger: You're the one the scout sent down for the water. Good. Stand there a moment and look at my shallows before you say anything cheerful."
done_line = "Ranger: The Scout's runner. Mind your feet on the stones."
