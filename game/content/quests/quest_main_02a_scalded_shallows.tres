[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2_objective")
kind = 0
target = &"creature_fire_03"
count = 3
description = "Drive three Slaglings back into the pit east of the pond"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_02a_scalded_shallows"
title = "Scalded Shallows"
kind = 0
summary = "The altar's first offering is stillwater, drawn cold from the pond. Slaglings out of the pit east of the shallows have it boiling, and the Ranger cannot draw a drop until they are driven back."
giver = &"ranger"
requires = &"quest_main_02_to_the_ranger"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_0")])
reward_currency = 70
reward_binding_scrolls = 1
reward_xp = 60
recommended_level = 9
offer_line = "Ranger: You're the one the scout sent down for the water?\n\nThen you have come at a poor time. Stillwater has to be drawn cold. Boiled water is no offering, it is only water.\n\nAnd Slaglings are crawling out of the pit east of here and sitting in the shallows until the whole shore steams.\n\nDrive three of them back and the pit settles."
accept_option = "I'll drive them back."
refuse_option = "Not yet."
accepted_line = "Ranger: They're slow and they're tough. Water and earth put them out quicker than fire does. Your Loambuck will earn its keep here."
caution_line = "Ranger: Hm. Slaglings hit harder than Emberlings, and yours still look green. I'd want them nearer level %d before wading in. Your call."
refused_line = "Ranger: Then the altar waits, and I keep watching the water boil."
reoffer_line = "Ranger: The shallows are still steaming. Changed your mind?"
progress_line = "Ranger: How goes it at the pit?"
continue_option = "Still at it."
abandon_option = "I can't manage it."
abandoned_line = "Ranger: They're stubborn things. Come back when you're ready."
complete_line = "Ranger: The water's cooling already.\n\nGive it till morning and I'll have your stillwater drawn and stoppered. That is one offering of three.\n\nWood is next, and it has to be cut green and never burned, which is exactly the trouble: the woodcutter in the west wood has been shouting about bats for days and cannot put an axe to anything while they are lighting his stacks."
done_line = "Ranger: The stillwater is drawn. Try the west wood; the woodcutter is waiting on you."
