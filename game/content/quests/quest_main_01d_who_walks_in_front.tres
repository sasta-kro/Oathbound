[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_lead"]
script = ExtResource("2_objective")
kind = 4
target = &"changed_lead"
count = 1
description = "Open your party page (Tab) and put a different Oathbound in front"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_01d_who_walks_in_front"
title = "Who Walks in Front"
kind = 0
summary = "Whichever Oathbound walks at your shoulder is the one that opens every fight, throws every blow you swing in the field and takes every blow swung at you.\n\nWhich one that is can be changed at any time from the party page."
giver = &"scout"
requires = &"quest_main_01c_field_mending"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_lead")])
reward_currency = 20
reward_xp = 10
offer_line = "Scout: One more thing off the page, and it matters more than it sounds.\n\nThe one walking at your shoulder is not decoration. It opens every fight, it throws whatever you swing out here, and it wears whatever gets swung at you.\n\nSo it should never be whichever one happened to be first. Going somewhere cold and wet?\n\nPut the one that likes cold and wet in front. Open the page and change it."
accept_option = "Let me see."
refuse_option = "Later."
accepted_line = "Scout: Tab, then the front button under whichever one you want leading. Try it. Look at the little one following you afterwards; that is who is in front now."
refused_line = "Scout: Then whoever is first stays first, and one day that will be the wrong one."
reoffer_line = "Scout: Ready to choose who walks in front?"
progress_line = "Scout: Party page, Tab. Put somebody else in front."
continue_option = "I'll change it."
abandon_option = "Not now."
abandoned_line = "Scout: Your shoulder, your choice."
complete_line = "Scout: There. Do that before every fight you can see coming, and half the fights you cannot.\n\nRight: that is everything the page can teach you. The rest is the field, and the field starts with the key you have not used yet."
done_line = "Scout: Whoever is in front takes the first blow. Choose on purpose."
