[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_find"]
script = ExtResource("2_objective")
kind = 2
target = &"aldric"
count = 1
description = "Go back to Aldric in the mouth of the stair"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_08_to_aldric"
title = "Back to the Stair"
kind = 0
summary = "Read, resupplied and put back together, there is nothing left in the camp to be handed. Aldric has been standing in the mouth of the stair since the bells rang, and he is the one who opens it."
giver = &"nurse"
turn_in = &"aldric"
requires = &"quest_main_08_a_champions_kit"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_find")])
reward_currency = 10
reward_xp = 15
offer_line = "The Nurse: That is everything this camp can put in your hands.\n\nGo back to Aldric, at the stair down. He has been standing in the mouth of it since the bells rang and he has been waiting for somebody to be ready.\n\nToday that is you, and I have run out of reasons to keep you here."
accept_option = "Back to the stair."
refuse_option = "Give me a moment."
accepted_line = "The Nurse: He is where he always is. He does not sit either."
refused_line = "The Nurse: Rest first, then. It is the one order I can give you."
reoffer_line = "The Nurse: Ready to go back to Aldric?"
progress_line = "The Nurse: Aldric. At the stair down, where he always is."
complete_line = "Aldric: So she has finished with you, and you came back up the hall on your own feet. Good. Then it is time you heard what is below this one, and who is standing in it."
done_line = "Aldric: The stair is behind me. It will be there when you are."
