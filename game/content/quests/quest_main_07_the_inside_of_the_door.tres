target = &"creature_gloomgaze"
count = 3
description = "Clear three Gloomgazes out of the bell-hall"

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2_objective")
kind = 0
target = &"creature_bulwark"
count = 2
description = "Break the two Bulwarks off the altar door"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_07_the_inside_of_the_door"
title = "The Inside of the Door"
kind = 0
summary = "The Bellkeeper has two posts: the rope that warns the Reach when the sleep thins, and the inside of the altar door, which the halls have held for four hundred years. The bell-hall is overrun and she cannot keep both."
giver = &"bellkeeper"
requires = &"quest_main_06_to_the_bellkeeper"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_0"), SubResource("Objective_1")])
reward_currency = 130
reward_binding_scrolls = 2
reward_xp = 1200
reward_item = &"item_revive_potion"
reward_item_count = 1
recommended_level = 24
offer_line = "The Bellkeeper: You are the one from upstairs. Good, then you can be useful.\n\nI have two posts and I am losing both. One is the rope: I ring when the sleep thins, and that is the only reason your Elder ever knows anything.\n\nThe other is that door above us, which I hold from this side, because things come up these halls whenever he stirs and not one of them has ever reached your town. They are in my bell-hall now.\n\nClear them out and I can ring and hold at once again."
accept_option = "I'll clear it."
refuse_option = "Not yet."
accepted_line = "The Bellkeeper: The gazers first. They hang high and they slow you, and the Bulwarks are trouble enough without being slow."
caution_line = "The Bellkeeper: I would not send you in at this size. Those Bulwarks do not move and do not care. Level %d, and bring something that mends."
refused_line = "The Bellkeeper: Then I hold it with one hand and ring with the other, as I have before. Go on."
reoffer_line = "The Bellkeeper: The bell-hall is still full of them. Well?"
progress_line = "The Bellkeeper: North end, under the rope. Are they down?"
continue_option = "Still working."
abandon_option = "It's not my post."
abandoned_line = "The Bellkeeper: Suit yourself. It is not your post. It was never supposed to be anyone's."
complete_line = "The Bellkeeper: Quiet. Listen to that. First quiet in a month. Go and find the Nurse at the camp before you go any further. She has been watching you come and go."
done_line = "The Bellkeeper: The Nurse is at the camp in the great hall. Go and be looked at."
