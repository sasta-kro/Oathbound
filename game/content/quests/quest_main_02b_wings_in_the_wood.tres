[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2_objective")
kind = 0
target = &"creature_scorchbat"
count = 3
description = "Clear three Scorchbats out of the west wood"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_02b_wings_in_the_wood"
title = "Wings in the Wood"
kind = 0
summary = "The altar's second offering is heartwood, cut green and never burned. Scorchbats have roosted in the west wood and lit the woodcutter's stacks twice, and nothing can be cut while they hunt."
giver = &"woodcutter"
requires = &"quest_main_02a_to_the_woodcutter"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_0")])
reward_currency = 80
reward_binding_scrolls = 1
reward_xp = 80
recommended_level = 11
offer_line = "Woodcutter: Ranger sent you?\n\nBless her. You'll be after the heartwood for the altar, and I'd have had it cut a week ago if it weren't for the bats.\n\nScorchbats, roosted in my wood, and twice now they've had my stacks alight. Burnt wood is no good to anybody up there.\n\nClear three out and you'll have your brand by nightfall."
accept_option = "I'll clear them out."
refuse_option = "Maybe later."
accepted_line = "Woodcutter: They swoop on anyone who gets close. Strike first if you can, and keep your Loambuck ready to patch up whoever takes the burns."
caution_line = "Woodcutter: Mind, these bats are no meadow pests. I've seen them tear through Oathbound tougher-looking than yours. Nearer level %d, I'd say, before you go poking at the roost."
refused_line = "Woodcutter: I'll be here, beating out fires."
reoffer_line = "Woodcutter: Still bats in my wood. You up for it now?"
progress_line = "Woodcutter: Any luck with the roost?"
continue_option = "Working on it."
abandon_option = "They're too fast for me."
abandoned_line = "Woodcutter: Can't blame you. Come back when you've got your feet under you."
complete_line = "Woodcutter: Quiet! First quiet night in a week. I'll cut your heartwood at first light, green and clean, the way it has to go up.\n\nThat is two of the three. The last one is not mine to give; it comes out of our own graves, and only a warden may ask for it.\n\nSerah is camped at the edge of the ruins, north-east. She came down the road the night the bells rang."
done_line = "Woodcutter: The warden is at the edge of the ruins, north-east. Tell her I sent you, and tell her the wood is cut."
