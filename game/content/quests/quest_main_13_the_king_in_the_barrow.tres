target = &"creature_skeleton_lord"
count = 1
description = "Put the king back to sleep"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_13_the_king_in_the_barrow"
title = "The King in the Barrow"
kind = 0
summary = "Up the road, past the glades and the pillars, the barrow.\n\nHe cannot be killed. He was never meant to be.\n\nHe can be put down hard enough and long enough for the rite to close over him, and then he sleeps, and that is the whole of the victory and always has been."
giver = &"lastchampion"
requires = &"quest_main_10_the_dead_wood"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_0")])
reward_currency = 400
reward_binding_scrolls = 5
reward_xp = 3000
recommended_level = 38
offer_line = "The Last Champion: You cannot kill him. Nobody can. That is not the Order failing and it is not you failing; it is the bargain, and the god of the dead does not take returns.\n\nWhat you can do is put him down hard enough he sleeps once more.\n\nThat is the whole victory. A brief respite for a kind king that is a mere shell now."
accept_option = "I'll put him under."
refuse_option = "Not yet."
accepted_line = "The Last Champion: He is waiting for you, like he have done for the countless others before you. Do not fail him. Give him the respite he desires."
caution_line = "The Last Champion: Below level %d I would not go up that barrow. I went up it at less, and you can see how that ended."
refused_line = "The Last Champion: Do not keep him waiting too long."
reoffer_line = "The Last Champion:  He is on the barrow surrounded only be dead."
progress_line = "The Last Champion: Up the road, past the pillars. The stone first, then him. I will not come and watch."
continue_option = "I'm going back up."
abandon_option = "I can't do it."
abandoned_line = "The Last Champion: Mm. Go back down to the fire and let Aldric look pleased about it. He will be, you know. He will be glad you came back."
complete_line = "The Last Champion: It has gone quiet. Look at the wood, champion. Look at it. I have sat under this tree for longer than your town has stood and yet each time it happens I cannot help but marvel."
done_line = "The Last Champion: Go up, champion. you have laid him to a peaceful slumber. Thank you."
