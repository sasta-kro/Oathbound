[resource]
script = ExtResource("1_quest")
id = &"quest_main_08_a_champions_kit"
title = "The Road to the Bench"
kind = 0
summary = "The Nurse keeps the only bench in these halls, and nobody can be carried to it.\n\nHexcallers hang over the east hall and two Ironhorns stand in the crypt road, and she will not clear a champion for the stair while the wounded cannot reach her."
giver = &"nurse"
requires = &"quest_main_07_to_the_nurse"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_0"), SubResource("Objective_1")])
reward_currency = 80
reward_binding_scrolls = 2
reward_xp = 1450
reward_item = &"item_hearty_tonic"
reward_item_count = 2
recommended_level = 26
offer_line = "The Nurse: Stop there. I have watched you cross this hall four times now and your Oathbound are held together with luck and good manners, and I will get to that in a moment.\n\nFirst you can do something for me, because I am the only bench in these halls and lately nobody can reach it. Three Hexcallers have come up into the east hall.\n\nThey put a hand on a man's head and he forgets which way the fire is. Past that, on the crypt road, two Ironhorns are standing square in the way.\n\nOpen that road for me. I am tired of being told to wait while somebody bleeds two halls off."
accept_option = "I'll open the road."
refuse_option = "I'm fine as I am."
accepted_line = "The Nurse: Hexcallers first, and do not give one a second turn at you. The Ironhorns will stand still until you are close, and then they move all at once."
caution_line = "The Nurse: I have buried people who went at Ironhorns light. Level %d, and bring something that mends, or you will be on my bench instead of beside it."
refused_line = "The Nurse: Then go up the road half-ready, like the last forty did. I will keep a bed clear."
reoffer_line = "The Nurse: The east hall and the crypt road. Have you come to your senses?"
progress_line = "The Nurse: Hexcallers in the east hall, Ironhorns on the crypt road. It is not a difficult list."
continue_option = "I'm getting to it."
abandon_option = "I don't need fussing."
abandoned_line = "The Nurse: Fine. It is your road. I have never once enjoyed being right about this."
complete_line = "The Nurse: The road is open. Good. Now sit down and let me look at your Oathbound, because that was always the half you were dreading.\n\nEvery champion who goes up that road goes up carrying what the last one paid for. That is the whole of this place. That is why we stayed.\n\nGo and find Aldric at the stair down. He has been standing in the mouth of it since the bells rang and he will not say why."
done_line = "The Nurse: Aldric is at the stair down. Go gently with him about it."
