[sub_resource type="Resource" id="Objective_defeat_oathbreaker"]
script = ExtResource("2_objective")
kind = 0
target = &"creature_earth_05"
count = 1
description = "Defeat the Black Knight at the altar"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_03_the_black_knight"
title = "The Black Knight"
kind = 0
summary = "A knight in black armour keeps watch over the altar at the end of the ruined road. It broke its oath long ago, and nothing passes it. The Scout believes the way beyond the ruins opens only once it falls."
giver = &"scout"
requires = &"quest_main_02_the_ruined_road"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_defeat_oathbreaker")])
reward_currency = 150
reward_binding_scrolls = 3
reward_xp = 80
offer_line = "Scout: With the road clear I went up to the altar. Something stands in front of it: a knight in black armour, taller than any man. It did not move, but it watched me the whole way back. The old stories call it the Oathbreaker. Nothing goes further while it stands. Will you face it?"
accept_option = "I will face the knight."
refuse_option = "I need to prepare first."
accepted_line = "Scout: It will not run and it will not bend to a scroll. Heal up in town, bring your strongest Oathbound, and hit it with everything you have."
refused_line = "Scout: Wise. Come back when you are ready. It is not going anywhere."
reoffer_line = "Scout: The Black Knight still waits at the altar. Are you ready now?"
progress_line = "Scout: The knight still stands. Do not face it tired."
continue_option = "I'm going back up."
abandon_option = "I can't beat it."
abandoned_line = "Scout: Then we wait and grow stronger. The knight is patient, and so can we be."
complete_line = "Scout: You brought it down? The Oathbreaker? I saw the light over the ruins from here. Take these. Whatever lies past the altar, the way is open now."
done_line = "Scout: The altar is quiet for the first time in living memory. The road beyond is yours to walk."
