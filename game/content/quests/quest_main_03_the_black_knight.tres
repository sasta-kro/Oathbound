[sub_resource type="Resource" id="Objective_defeat_oathbreaker"]
script = ExtResource("2_objective")
kind = 0
target = &"creature_oathbreaker"
count = 1
description = "Defeat the Oathbreaker at the altar"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_03_the_black_knight"
title = "The Oathbreaker"
kind = 0
summary = "The rite is gathered, and the Oathbreaker keeps the altar as he has kept it for every champion before.\n\nHe is not an enemy, but he does not stand aside for anyone who cannot put him down, because whatever waits under the altar is worse."
giver = &"warden"
requires = &"quest_main_02c_the_hollow_watch"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_defeat_oathbreaker")])
reward_currency = 150
reward_binding_scrolls = 3
reward_xp = 80
recommended_level = 15
offer_line = "Warden: The knight at the altar was one of the dead king's own, once.\n\nWhen the king reached past what a king may touch, the magic went through his knights before it ever reached his son, and it took the man's oath out of him whether he willed it or not.\n\nThat is the name he carries. He turned all the same, and he has stood in front of that altar ever since, on our side of it.\n\nHe is not your enemy. He is your last gate. Nobody goes down to the king who cannot first beat the Oathbreaker, because the king is worse.\n\nBring him down and he will stand aside himself. Will you face him?"
accept_option = "I will face the knight."
refuse_option = "I need to prepare first."
accepted_line = "Warden: Let me mend your Oathbound first. Then take him the way you would take the king: everything you have, all at once.\n\nKeep your Loambuck ready, because this fight will be long. He will not kill you. He never has. That is not what he is for."
refused_line = "Warden: Wise. Come back when you are ready. He is not going anywhere; that is rather the point of him."
reoffer_line = "Warden: The Oathbreaker still keeps the altar. Are you ready now?"
progress_line = "Warden: The knight still stands. Rest here before you go up."
continue_option = "I'm going back up."
abandon_option = "I can't beat it."
abandoned_line = "Warden: Then we wait and grow stronger. He is patient, and so can we be."
complete_line = "Warden: He stood aside for you?\n\nThen it is done, and it has begun. I saw the light come up over the ruins from here.\n\nGo down while it burns, put the king back under, and come home.\n\nIn thirty years you will be the one sitting at the edge of these ruins, telling some frightened child that the knight will not kill them."
done_line = "Warden: The passage is open and the light is holding. Whatever is down there, it has never yet been more than we could carry."
caution_line = "Warden: One more thing. He goes easy on nobody, and he is stronger than anything you have faced.\n\nI would not send a champion whose lead is below level %d. Train on the graves and in the wood if you must; he has waited a great deal longer than that."
