[sub_resource type="Resource" id="Objective_defeat_oathbreaker"]
script = ExtResource("2_objective")
kind = 0
target = &"creature_earth_05"
count = 1
description = "Defeat the Black Knight at the altar"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_03_the_black_knight"
title = "The Black Knight"
kind = 0
summary = "A knight in black armour keeps watch over the altar at the end of the ruined road. It broke its oath long ago, and nothing passes it. The Warden believes the way beyond the ruins opens only once it falls."
giver = &"warden"
requires = &"quest_main_02c_the_hollow_watch"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_defeat_oathbreaker")])
reward_currency = 150
reward_binding_scrolls = 3
reward_xp = 80
recommended_level = 15
offer_line = "Warden: The thing at the altar was a knight of our Order once. It swore to guard that place, and it broke the oath, and still it stands. We call it the Oathbreaker. It does not run, and it does not bend to a scroll. Nothing goes past the ruins while it stands. Will you face it?"
accept_option = "I will face the knight."
refuse_option = "I need to prepare first."
accepted_line = "Warden: Let me mend your Oathbound first. Then bring your strongest to the altar and hit it with everything you have. Keep your Loambuck ready; this fight will be long."
refused_line = "Warden: Wise. Come back when you are ready. It is not going anywhere."
reoffer_line = "Warden: The Black Knight still waits at the altar. Are you ready now?"
progress_line = "Warden: The knight still stands. Rest here before you go up."
continue_option = "I'm going back up."
abandon_option = "I can't beat it."
abandoned_line = "Warden: Then we wait and grow stronger. The knight is patient, and so can we be."
complete_line = "Warden: You brought it down? The Oathbreaker? I saw the light over the ruins from here. Take these. The way past the altar is open, and the Order owes you a debt."
done_line = "Warden: The altar is quiet for the first time in living memory. The road beyond is yours to walk."
caution_line = "Warden: One more thing. It is stronger than anything you have faced. I would not send anyone whose lead is below level %d. Train on the graves and the wood if you must; the knight will wait."
