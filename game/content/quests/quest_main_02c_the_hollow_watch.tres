[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("2_objective")
kind = 0
target = &"creature_earth_03"
count = 2
description = "Put two Hollow Squires back in their graves"

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("2_objective")
kind = 0
target = &"creature_fire_02"
count = 1
description = "Bring down the Cinderclaw guarding the road to the altar"

[resource]
script = ExtResource("1_quest")
id = &"quest_main_02c_the_hollow_watch"
title = "The Hollow Watch"
kind = 0
summary = "The altar's last offering is seal-iron, the sigil the Order buries with its own. The graves west of the altar are stirring, and a Cinderclaw holds the last stretch of road, so the Warden will not let anyone lift a sigil until both are dealt with."
giver = &"warden"
requires = &"quest_main_02b_wings_in_the_wood"
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_0"), SubResource("Objective_1")])
reward_currency = 100
reward_binding_scrolls = 2
reward_xp = 100
recommended_level = 13
offer_line = "Warden: So you're the one the woodcutter keeps talking about. I'm Serah, warden of the Order. Water and wood you have. The third offering is ours: seal-iron, the sigil every one of us is buried with, and it must be lifted from the graves by hand. The trouble is that the graves are stirring, as they always stir when the seal thins, and there is a Cinderclaw squatting on the last stretch of road besides. Put two of the squires back to rest, and the Cinderclaw down with them."
accept_option = "I'll face them."
refuse_option = "I need more time."
accepted_line = "Warden: The graves are just west of the altar. The Cinderclaw stalks the road where the paving starts. Come back to me between fights; I'll see your Oathbound mended."
caution_line = "Warden: I won't stop you. Understand what you are facing, though. Those squires walked this road as champions before you did, and they remember how to fight. If your lead were nearer level %d, I'd sleep easier."
refused_line = "Warden: Take your time. The graves have waited a hundred years; they'll wait a few more days."
reoffer_line = "Warden: Ready to face the graves?"
progress_line = "Warden: The graves still stir. How do you fare?"
continue_option = "I'm going back."
abandon_option = "It's beyond me."
abandoned_line = "Warden: No shame in knowing your limits. Grow, and return."
complete_line = "Warden: Two squires at rest, the Cinderclaw down, and the seal-iron in my hand. Water, wood and iron. The rite is whole. Sit down, then, because there is one thing left standing between you and that altar, and you have known his name since you could talk."
done_line = "Warden: The graves are quiet and the rite is gathered. Only the knight is left."
